// OrderSathi data model.
// Money is stored in integer paise. Quantities use Decimal to avoid float drift.
// Every business record carries workspaceId so queries can be scoped explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Authentication (better-auth) ─────────────────────────

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────── Workspaces & access ─────────────────────────

enum Role {
  OWNER
  MANAGER
  OPERATOR
}

enum Language {
  AUTO
  EN
  TE
}

model Workspace {
  id                  String   @id @default(cuid())
  name                String
  city                String
  state               String   @default("Telangana")
  addressLine         String?
  phone               String?
  gstin               String?
  preferredLanguage   Language @default(AUTO)
  timezone            String   @default("Asia/Kolkata")
  isDemo              Boolean  @default(false)
  // Optional tax line on confirmations. Null = no tax applied (never assumed).
  taxRateBps          Int?
  taxLabel            String?
  sourceRetentionDays Int      @default(90)
  orderSeq            Int      @default(0)
  onboardingStep      Int      @default(0) // 0..4, 5 = complete
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  products       Product[]
  aliases        ProductAlias[]
  customers      Customer[]
  customerPrices CustomerPrice[]
  uploads        SourceUpload[]
  jobs           ProcessingJob[]
  orders         Order[]
  clarifications Clarification[]
  auditEvents    AuditEvent[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role
  invitedById String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([workspaceId])
}

// ───────────────────────── Catalogue ─────────────────────────

enum AliasLanguage {
  EN
  TE
  TRANSLIT
}

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  sku         String
  name        String
  category    String
  brand       String?
  // Flat string map, e.g. { "rating": "6A", "size": "2.5 sq mm", "length": "90 m" }
  specs       Json      @default("{}")
  sellingUnit String // PIECE | BOX | ROLL | METRE | PACKET | SET | COIL | KG
  pricePaise  Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aliases        ProductAlias[]
  conversions    UnitConversion[]
  customerPrices CustomerPrice[]
  orderLines     OrderLine[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, archivedAt])
}

model ProductAlias {
  id          String        @id @default(cuid())
  workspaceId String
  productId   String
  customerId  String? // customer-specific alias when set
  text        String
  normalized  String
  language    AliasLanguage
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, normalized])
  @@index([productId])
}

// 1 `unit` = `factor` selling units. Only explicit rows allow conversion.
model UnitConversion {
  id        String  @id @default(cuid())
  productId String
  unit      String
  factor    Decimal @db.Decimal(12, 4)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unit])
}

// ───────────────────────── Customers ─────────────────────────

model Customer {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String // shop / business name
  contactName       String?
  phone             String?
  city              String?
  preferredLanguage Language  @default(AUTO)
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prices    CustomerPrice[]
  aliases   ProductAlias[]
  orders    Order[]

  @@index([workspaceId])
}

model CustomerPrice {
  id          String    @id @default(cuid())
  workspaceId String
  customerId  String
  productId   String
  pricePaise  Int
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([workspaceId])
}

// ───────────────────────── Intake & processing ─────────────────────────

enum InputType {
  TEXT
  AUDIO
  IMAGE
}

model SourceUpload {
  id           String          @id @default(cuid())
  workspaceId  String
  kind         InputType
  storageKey   String? // null for typed text
  mimeType     String?
  sizeBytes    Int?
  sha256       String?
  originalName String?
  createdById  String
  createdAt    DateTime        @default(now())
  purgedAt     DateTime?
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders       Order[]
  jobs         ProcessingJob[]

  @@index([workspaceId, createdAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobStage {
  STORED
  TRANSCRIBING
  EXTRACTING
  MATCHING
  PRICING
  VALIDATING
  SAVED
}

model ProcessingJob {
  id             String        @id @default(cuid())
  workspaceId    String
  orderId        String
  sourceUploadId String?
  kind           String // INTAKE | REPROCESS
  status         JobStatus     @default(QUEUED)
  stage          JobStage      @default(STORED)
  attempts       Int           @default(0)
  errorCode      String?
  errorMessage   String? // safe, user-facing; never raw provider payloads
  retryable      Boolean       @default(true)
  provider       String?
  model          String?
  extraction     Json? // schema-validated extraction result
  transcript     String?
  createdById    String
  createdAt      DateTime      @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  leaseUntil     DateTime?
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceUpload   SourceUpload? @relation(fields: [sourceUploadId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([orderId])
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  DRAFT
  NEEDS_CLARIFICATION
  READY_FOR_REVIEW
  APPROVED
  REJECTED
}

model Order {
  id               String      @id @default(cuid())
  workspaceId      String
  number           Int
  customerId       String?
  status           OrderStatus @default(DRAFT)
  inputType        InputType
  inputLanguage    Language    @default(AUTO)
  detectedLanguage String?
  sourceText       String? // original typed/pasted message
  transcript       String? // editable working transcript
  transcriptDirty  Boolean     @default(false) // edited since last processing
  sourceUploadId   String?
  idempotencyKey   String
  version          Int         @default(1)
  subtotalPaise    Int         @default(0)
  taxPaise         Int         @default(0)
  totalPaise       Int         @default(0)
  taxRateBps       Int?
  notes            String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  approvedAt       DateTime?
  approvedById     String?
  approvedSnapshot Json?
  rejectedAt       DateTime?
  rejectedById     String?
  rejectionReason  String?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id])
  sourceUpload   SourceUpload?   @relation(fields: [sourceUploadId], references: [id])
  lines          OrderLine[]
  jobs           ProcessingJob[]
  clarifications Clarification[]
  auditEvents    AuditEvent[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
}

enum LineStatus {
  CONFIRMED
  NEEDS_REVIEW
  MISSING_INFO
  UNMATCHED
}

model OrderLine {
  id             String     @id @default(cuid())
  orderId        String
  position       Int
  originalText   String
  description    String? // extracted product description
  extracted      Json       @default("{}") // brand/specs mentioned in source
  productId      String?
  quantity       Decimal?   @db.Decimal(12, 3) // as requested
  unit           String? // as requested (normalized code) or null
  rawUnit        String? // unit wording from the source
  sellQuantity   Decimal?   @db.Decimal(12, 3) // in product selling unit
  unitPricePaise Int?
  priceSource    String? // CUSTOMER | STANDARD
  lineTotalPaise Int?
  status         LineStatus @default(NEEDS_REVIEW)
  issues         Json       @default("[]")
  candidates     Json       @default("[]")
  manuallyEdited Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?   @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum ClarificationStatus {
  DRAFT
  COPIED
  SHARED
}

model Clarification {
  id          String              @id @default(cuid())
  workspaceId String
  orderId     String
  message     String
  status      ClarificationStatus @default(DRAFT)
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  orderId     String?
  actorId     String?
  actorName   String?
  type        String
  data        Json      @default("{}")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([orderId])
}

// Uploaded source files when STORAGE_DRIVER=database (used on serverless hosts such as Vercel).
model StoredFile {
  key         String   @id
  workspaceId String
  bytes       Bytes
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}
