# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://ordersathi:ordersathi@localhost:5432/ordersathi"
# Direct (non-pooled) connection used for migrations. Locally: same as DATABASE_URL.
# On Vercel + Neon this is set automatically by the Neon integration.
DATABASE_URL_UNPOOLED="postgresql://ordersathi:ordersathi@localhost:5432/ordersathi"
# Random string of 32+ characters used to sign sessions (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=""
# Public base URL of the app (on Vercel, set to your production URL; previews fall back to VERCEL_URL)
BETTER_AUTH_URL="http://localhost:3000"

# ── Storage ─────────────────────────────────────────────────────────────────
# "local" (files under STORAGE_DIR) or "database" (bytes in Postgres). Defaults to "database" on Vercel.
STORAGE_DRIVER=""
# Private directory for uploaded voice notes and photos when STORAGE_DRIVER=local (never under /public)
STORAGE_DIR="./storage"
# Protects the daily retention-purge cron endpoint (/api/cron/retention)
CRON_SECRET=""

# ── Processing providers (optional — the app runs in demo mode without them) ──
# Claude: structured order extraction from text and reading photos of lists
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# Optional custom endpoint for the Anthropic API
ORDERSATHI_ANTHROPIC_BASE_URL=""
# OpenAI: speech-to-text for voice notes (Telugu and English)
OPENAI_API_KEY=""
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
# "auto" uses Claude for text extraction when a key is set; "rules" forces the deterministic parser
EXTRACTION_PROVIDER="auto"

# ── Limits ──────────────────────────────────────────────────────────────────
PROVIDER_TIMEOUT_MS=45000
MAX_AUDIO_MB=16
MAX_IMAGE_MB=10
MAX_TEXT_CHARS=8000
# Max processing jobs per workspace per 10 minutes
PROCESSING_LIMIT_PER_10_MIN=40

# Show the one-click sample-workspace logins on the sign-in page ("false" in production)
SHOW_DEMO_LOGIN="true"
